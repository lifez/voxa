#!/bin/sh
# Native control path; preserve the existing Node setup/settings/test utilities.
case "${1-}" in
  daemon|start|stop|toggle|status|test-osd)
    exec "$HOME/.local/share/voxa/native/voxa-c" \
      --socket "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/voxa.sock" "$@"
    ;;
  *)
    exec /usr/bin/env node "$HOME/.local/share/voxa/dist/index.js" "$@"
    ;;
esac
