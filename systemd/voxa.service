[Unit]
Description=Push-to-talk Voxa dictation
After=graphical-session.target pipewire.service
PartOf=graphical-session.target

[Service]
Type=simple
# The daemon reads the key file at the beginning of every recording.
ExecStart=%h/.local/share/voxa/voxa daemon
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
